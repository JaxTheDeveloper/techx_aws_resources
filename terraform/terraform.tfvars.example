aws_region   = "us-west-2"
project_name = "dochub-w7"
environment  = "hackathon"
team_tag     = "G1"
owner_email  = "your-email@example.com"

# Custom domain (Bonus Path C) — requires existing Route 53 hosted zone
custom_domain = "docs4hub.tech"

vpc_cidr                 = "10.0.0.0/16"
vpc_az1_private_app_cidr = "10.0.8.0/22"
vpc_az2_private_app_cidr = "10.0.12.0/22"

# Get these from Google Cloud Console → APIs & Services → Credentials
google_oauth_client_id     = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
google_oauth_client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

lambda_memory_mb   = 512
lambda_timeout_sec = 60

bedrock_foundation_model_id = "anthropic.claude-3-5-haiku-20241022-v1:0"
bedrock_embedding_model_id  = "amazon.titan-embed-text-v2:0"

budget_limit_usd = "100"
budget_alert_pct = 80
